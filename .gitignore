
**/*.pt
**/checkpoints
**/wget-log
**/_build/
**/*.ckpt
**/outputs
**/*.tar.gz
**/playground
**/wandb

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
dataset/*
tensorflow/my_graph/*
.idea/
# C extensions
*.so

# Distribution / packaging
.Python
# env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
tmp/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
.venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# vscode
.vscode

# Mac
.DS_Store

# vim
*.swp

# ckpt
*.lock

# data
*.parquet


# local logs
logs
log

# nohup
*.out
outputs

# appworld
data/
.tmp
*ports

# bundled environment packages: keep their source tracked, since the generic
# rules above (e.g. ENV/, data/) would otherwise drop required ALFWorld files
!agent_system/environments/env_package/
!agent_system/environments/env_package/**

# ...but never commit locally built artifacts of those packages
agent_system/environments/env_package/webshop/webshop/data/
agent_system/environments/env_package/webshop/webshop/**/chromedriver
agent_system/environments/env_package/alfworld/alfworld/detectors/

# CPU setup checks import bundled packages; their bytecode is generated locally.
agent_system/environments/env_package/**/__pycache__/
agent_system/environments/env_package/**/*.py[cod]

# Pointer to the latest local experiment; run state stays outside version control.
/configs/setup/active_opd_benchmark.txt
